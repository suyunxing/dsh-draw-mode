{
  "name": "dsh-draw-mode",
  "version": "2.0.1",
  "description": "Link a local ComfyUI server into DeepSeek Harness. Ships as an empty framework: point it at the workflows you exported from ComfyUI, then generate, edit and reverse-engineer images from chat. Workflows are auto-discovered, parameters mapped, LoRA injected; headless auto-start, inline image delivery and a settings panel included.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "suyunxing <suyunxings@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suyunxing/dsh-draw-mode.git"
  },
  "homepage": "https://github.com/suyunxing/dsh-draw-mode",
  "bugs": {
    "url": "https://github.com/suyunxing/dsh-draw-mode/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "image-generation",
    "text-to-image",
    "lora"
  ]
}
